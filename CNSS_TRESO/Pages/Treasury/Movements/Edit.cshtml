@page "{number:int}"
@model CNSS_TRESO.Pages.Treasury.Movements.EditModel
@{
    ViewData["Title"] = $"Modifier mouvement #{Model.Number}";
}

<section class="hero">
    <h1>Modifier mouvement #@Model.Number</h1>
    <p class="text-muted">Journal: <strong>@Model.Journal</strong> &middot; brouillon uniquement</p>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    <form method="post" class="feature-card">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Document</label>
                <select class="form-select" asp-for="Input.DocumentCode">
                    @foreach (var d in Model.Documents)
                    {
                        <option value="@d.Code">@d.Code — @d.Label</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">N° document</label>
                <input class="form-control" asp-for="Input.DocumentNumber" type="number" />
            </div>
            <div class="col-md-2">
                <label class="form-label">N° pièce</label>
                <input class="form-control" asp-for="Input.PieceNumber" type="number" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Date</label>
                <input class="form-control" asp-for="Input.MovementDate" type="date" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Sens</label>
                <select class="form-select" asp-for="Input.Direction">
                    <option value="D">Dépense</option>
                    <option value="R">Recette</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label">Montant</label>
                <input class="form-control" asp-for="Input.Amount" type="number" step="0.01" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Devise</label>
                <select class="form-select" asp-for="Input.CurrencyCode">
                    @foreach (var c in Model.Currencies)
                    {
                        <option value="@c.Code">@c.Code — @c.Label</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Taux</label>
                <input class="form-control" asp-for="Input.Rate" type="number" step="0.0001" min="0.0001" required />
            </div>
            <div class="col-md-2">
                <label class="form-label">Type mouvement</label>
                <select class="form-select" asp-for="Input.MovementType">
                    <option value="Esp">Espèces</option>
                    <option value="Chq">Chèque</option>
                    <option value="Vir">Virement</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label">Tiers</label>
                <select class="form-select" asp-for="Input.AccountType">
                    <option value="">--</option>
                    @foreach (var t in Model.TiersList)
                    {
                        <option value="@t.Code">@t.Code — @t.Designation</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Compte</label>
                <input class="form-control" asp-for="Input.Account" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Payeur</label>
                <input class="form-control" asp-for="Input.Payer" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Bénéficiaire</label>
                <input class="form-control" asp-for="Input.Beneficiary" />
            </div>

            <div class="col-md-3">
                <label class="form-label">N° chèque</label>
                <input class="form-control" asp-for="Input.CheckNumber" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Banque</label>
                <input class="form-control" asp-for="Input.Bank" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Description</label>
                <input class="form-control" asp-for="Input.Description" />
            </div>
        </div>

        <div class="mt-3 d-flex gap-2">
            <button class="btn btn-primary" type="submit">Enregistrer</button>
            <a class="btn btn-outline-secondary" asp-page="Index">Annuler</a>
        </div>
    </form>
</section>
