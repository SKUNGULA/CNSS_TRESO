@page
@model CNSS_TRESO.Pages.Treasury.Movements.IndexModel
@{
    ViewData["Title"] = "Consultation mouvements";
}

<section class="hero">
    <h1>Consultation mouvements</h1>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }

    <div class="feature-card mt-3">
        <form method="get" class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Du</label>
                <input class="form-control" asp-for="FromDate" type="date" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Au</label>
                <input class="form-control" asp-for="ToDate" type="date" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Journal</label>
                <select class="form-select" asp-for="Journal">
                    <option value="">Tous les journaux</option>
                    @foreach (var journal in Model.Journals)
                    {
                        <option value="@journal.Number">@journal.Number - @journal.Label</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end gap-2">
                <div class="form-check">
                    <input class="form-check-input" asp-for="OnlyUnvalidated" type="checkbox" />
                    <label class="form-check-label" asp-for="OnlyUnvalidated">Non validés uniquement</label>
                </div>
                <button class="btn btn-primary ms-auto" type="submit">Filtrer</button>
            </div>
        </form>
    </div>

    <div class="feature-card mt-3">
        @if (User.IsInRole("Administrator") && !string.IsNullOrWhiteSpace(Model.Journal) && Model.FromDate.HasValue)
        {
            <form method="post" class="d-flex flex-wrap align-items-end gap-2 mb-3">
                <input type="hidden" name="journal" value="@Model.Journal" />
                <input type="hidden" name="movementDate" value="@Model.FromDate.Value.ToString("yyyy-MM-dd")" />
                <button class="btn btn-success btn-sm" type="submit" asp-page-handler="ValidateGroup">Valider le journal du @Model.FromDate.Value.ToString("dd/MM/yyyy")</button>
                <input class="form-control form-control-sm" style="max-width: 280px" name="reason" minlength="4" placeholder="Motif de dévalidation" required />
                <button class="btn btn-outline-warning btn-sm" type="submit" asp-page-handler="DevalidateGroup">Dévalider le groupe</button>
            </form>
        }
        <div class="table-responsive">
            <table class="table table-striped table-sm align-middle">
                <thead>
                    <tr>
                        <th>N°</th>
                        <th>Date</th>
                        <th>Doc</th>
                        <th>N° doc</th>
                        <th>Description</th>
                        <th class="text-end">Montant</th>
                        <th>Devise</th>
                        <th>Sens</th>
                        <th>Centre</th>
                        <th>Validé</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var m in Model.Movements)
                {
                    <tr>
                        <td>@m.Number</td>
                        <td>@m.MovementDate?.ToString("yyyy-MM-dd")</td>
                        <td>@m.DocumentCode</td>
                        <td>@m.DocumentNumber</td>
                        <td>@m.Description</td>
                        <td class="text-end">@(m.Amount?.ToString("N2") ?? "-")</td>
                        <td>@m.CurrencyCode</td>
                        <td>@m.Direction</td>
                        <td>@m.CostCenter</td>
                        <td>
                            @if (m.Validated == true)
                            {
                                <span class="badge bg-success">Oui</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Non</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (m.Validated != true)
                            {
                                <a class="btn btn-sm btn-outline-primary" asp-page="Edit" asp-route-number="@m.Number">Modifier</a>
                                <a class="btn btn-sm btn-outline-danger" asp-page="Delete" asp-route-number="@m.Number">Supprimer</a>
                            }
                            @if (User.IsInRole("Administrator"))
                            {
                                if (m.Validated == true)
                                {
                                    <form method="post" asp-page-handler="Devalidate" asp-route-number="@m.Number" class="d-inline">
                                        <input class="form-control form-control-sm d-inline-block" style="width: 160px" name="reason" minlength="4" placeholder="Motif" required />
                                        <button class="btn btn-sm btn-outline-warning" type="submit">Dévalider</button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="Validate" asp-route-number="@m.Number" class="d-inline">
                                        <button class="btn btn-sm btn-outline-success" type="submit">Valider</button>
                                    </form>
                                }
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</section>
