<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CNSS_TRESO</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CNSS_TRESO.styles.css" asp-append-version="true" />
    <style>
        body.login-body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background: linear-gradient(135deg, #0d3b66 0%, #1d7874 100%);
        }
        .login-wrap {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
        }
        .login-card {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 18px 45px rgba(0,0,0,.25);
            width: 100%;
            max-width: 420px;
            padding: 2.5rem 2rem;
        }
        .login-brand {
            text-align: center;
            margin-bottom: 1.5rem;
        }
        .login-logo { max-height: 80px; width: auto; margin-bottom: .75rem; }
        .login-brand h1 {
            font-size: 1.5rem;
            font-weight: 700;
            color: #0d3b66;
            margin: 0;
        }
        .login-brand small { color: #555; }
        .login-footer {
            text-align: center;
            color: rgba(255,255,255,.85);
            padding: 1rem;
            font-size: .85rem;
        }
    </style>
</head>
<body class="login-body">
    <div class="login-wrap">
        <div class="login-card">
            <div class="login-brand">
                @{ ViewData["LogoCssClass"] = "login-logo"; }
                <partial name="_BrandLogo" />
                <h1>CNSS &mdash; TRESO</h1>
                <small>Gestion de la tresorerie</small>
            </div>
            @RenderBody()
        </div>
    </div>
    <footer class="login-footer">
        &copy; 2026 - CNSS_TRESO
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
