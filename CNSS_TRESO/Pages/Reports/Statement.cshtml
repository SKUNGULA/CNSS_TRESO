@page
@model CNSS_TRESO.Pages.Reports.StatementModel
@{
    ViewData["Title"] = "Releve des mouvements";
}

<section class="hero">
    <h1 class="no-print">Releve des mouvements</h1>

    <form method="get" class="feature-card row g-3">
        <div class="col-md-3">
            <label class="form-label">Du</label>
            <input class="form-control" asp-for="FromDate" type="date" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Au</label>
            <input class="form-control" asp-for="ToDate" type="date" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Journal (optionnel)</label>
            <select class="form-select" asp-for="JournalCode" asp-items="Model.JournalOptions">
                <option value="">— Tous —</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Centre</label>
            <input class="form-control" asp-for="CostCenter" />
        </div>
        <div class="col-md-1 d-flex align-items-end">
            <button class="btn btn-primary w-100" type="submit">Generer</button>
        </div>
    </form>

    @if (Model.Report is not null)
    {
        var r = Model.Report;
        <div class="feature-card mt-3 print-area">
            <partial name="_ReportLetterhead" model="@(new CNSS_TRESO.Pages.Shared.ReportLetterheadModel { CostCenter = r.CostCenter, CostCenterLabel = r.CostCenterLabel })" />
            <h4 class="text-center mb-2 print-only">RELEVE DES MOUVEMENTS</h4>
            <div class="mb-2 no-print">
                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print()">Imprimer</button>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div>
                    <strong>Periode :</strong> @r.FromDate.ToString("yyyy-MM-dd") au @r.ToDate.ToString("yyyy-MM-dd")
                    @if (!string.IsNullOrWhiteSpace(r.JournalCode)) { <span> &middot; <strong>Journal :</strong> @r.JournalCode @r.JournalLabel</span> }
                </div>
                <span class="badge bg-secondary">@r.Count mouvements</span>
            </div>
            <div class="table-responsive">
                <table class="table table-striped table-sm align-middle">
                    <thead>
                        <tr>
                            <th>N°</th>
                            <th>Date</th>
                            <th>Journal</th>
                            <th>Document</th>
                            <th>Description</th>
                            <th>Tiers / Beneficiaire</th>
                            <th>Compte</th>
                            <th class="text-end">Recette</th>
                            <th class="text-end">Depense</th>
                            <th>Devise</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in r.Rows)
                        {
                            <tr>
                                <td>@row.Number</td>
                                <td>@row.Date?.ToString("yyyy-MM-dd")</td>
                                <td>@row.Journal</td>
                                <td>@row.DocumentCode / @row.DocumentNumber</td>
                                <td>@row.Description</td>
                                <td>@row.Beneficiary</td>
                                <td>@row.Account</td>
                                <td class="text-end">@(row.Receipt > 0 ? row.Receipt.ToString("N2") : "-")</td>
                                <td class="text-end">@(row.Expense > 0 ? row.Expense.ToString("N2") : "-")</td>
                                <td>@row.Currency</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="fw-bold">
                            <td colspan="7" class="text-end">Totaux</td>
                            <td class="text-end">@r.TotalReceipts.ToString("N2")</td>
                            <td class="text-end">@r.TotalExpenses.ToString("N2")</td>
                            <td>Net : @r.Net.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }
</section>
