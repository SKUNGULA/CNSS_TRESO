@page
@model CNSS_TRESO.Pages.Users.JournalsModel
@{
    ViewData["Title"] = "Journaux utilisateur";
}

<section class="hero">
    <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
        <div>
            <h1>Journaux de @Model.TargetUser?.Username</h1>
            <p class="text-muted mb-0">Centre de frais : @Model.TargetUser?.CostCenter</p>
        </div>
        <a class="btn btn-outline-secondary" asp-page="./Index">Retour</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }

    <div class="feature-card">
        <form method="post">
            <input type="hidden" asp-for="Username" />
            @if (Model.AvailableJournals.Count == 0)
            {
                <p class="text-muted mb-0">Aucun journal n'est créé pour ce centre de frais.</p>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var journal in Model.AvailableJournals)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="form-check border rounded p-3 h-100">
                                <input class="form-check-input" type="checkbox" name="SelectedJournals" value="@journal.Number" checked="@Model.SelectedJournals.Contains(journal.Number, StringComparer.OrdinalIgnoreCase)" id="journal-@journal.Number" />
                                <label class="form-check-label" for="journal-@journal.Number">
                                    <strong>@journal.Number</strong><br />
                                    <span>@journal.Label</span><br />
                                    <small class="text-muted">@journal.Type - @journal.Currency</small>
                                </label>
                            </div>
                        </div>
                    }
                </div>
                <div class="mt-3">
                    <button class="btn btn-success" type="submit">Enregistrer les journaux</button>
                </div>
            }
        </form>
    </div>
</section>